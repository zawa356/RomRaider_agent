# RRBridge の動作設定（任意）。rrbridge.properties として RRBridge フォルダに置く。未設定の項目は既定値。
# HTTP(127.0.0.1:18765) に認証を掛ける場合に設定。設定すると Authorization: Bearer <token> が必要になる
http.token=
# switch_profile でプロファイル読込後、CSV記録を再開するまでの待ち（ms、0〜10000）
switch.settleMs=1500
# rrbridge.log の上限（バイト）。超えたら rrbridge.log.1 に退避
log.maxBytes=5242880
# 送信済みspoolを残す日数（0以下で削除しない）。未送信のものと現在のセッションは消さない
spool.retentionDays=14
# --- 取得速度ガード（v0.5.0〜）---
# プロファイルで選択できる項目数の上限。超えるプロファイルは読み込まない（0で無制限）
# 実績: 8項目で約8Hz、13〜14項目で3〜4Hz、18〜19項目で約2.7Hz（2026-09-21 実車）
profile.maxParams=20
# 切替後に取得周波数が下限を割ったら、直前のプロファイルへ自動で戻す
guard.enabled=true
guard.minRateHz=2.0
# 切替（＋switch.settleMs）後に速度を測る時間（ms、3000〜60000）
guard.checkMs=10000
# 直前のプロファイルが分からないとき（起動直後など）に戻す先
guard.fallbackProfile=basic.xml
